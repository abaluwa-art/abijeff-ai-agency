        "sendTo": "={{ $('Config').first().json.ownerEmail }}",
        "subject": "={{ (($('Reconciliation Agent').item.json.output.urgent || []).length ? 'URGENT – ' : '') + 'Reconciliation ' + $('Find Exceptions').item.json.weekOf }}",
        "emailType": "text",
        "message": "={{ $('Reconciliation Agent').item.json.output.summary + '\\n\\nURGENT\\n' + (($('Reconciliation Agent').item.json.output.urgent || []).map(x => '• ' + (typeof x === 'string' ? x : JSON.stringify(x))).join('\\n') || '• none') + '\\n\\nSales without a ZRA fiscal invoice (> 48 h)\\n' + (($('Reconciliation Agent').item.json.output.missing_fiscal_invoice || []).map(x => '• ' + (typeof x === 'string' ? x : JSON.stringify(x))).join('\\n') || '• none') + '\\n\\nQuickBooks invoices with no Airtable order\\n' + (($('Reconciliation Agent').item.json.output.orphan_qbo_invoices || []).map(x => '• ' + (typeof x === 'string' ? x : JSON.stringify(x))).join('\\n') || '• none') + '\\n\\nUnapplied payments / paid-but-open\\n' + (($('Reconciliation Agent').item.json.output.unapplied_payments || []).map(x => '• ' + (typeof x === 'string' ? x : JSON.stringify(x))).join('\\n') || '• none') + '\\n\\nOverdue receivables\\n' + (($('Reconciliation Agent').item.json.output.overdue_ar || []).map(x => '• ' + (typeof x === 'string' ? x : JSON.stringify(x))).join('\\n') || '• none') + '\\n\\nOpen AIOS errors\\n' + (($('Reconciliation Agent').item.json.output.open_errors || []).map(x => '• ' + (typeof x === 'string' ? x : JSON.stringify(x))).join('\\n') || '• none') + '\\n\\nReminder drafts for 1–30 day overdue invoices are in Gmail → Drafts.' }}",
