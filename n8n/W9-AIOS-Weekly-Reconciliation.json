        "autoFix": false
      },
      "id": "4ee02b7e-c2bb-433b-ad07-f2c40763691e",
      "name": "Reconciliation Schema",
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.2,
      "position": [
