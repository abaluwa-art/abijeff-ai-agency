          "responseFormTitle": "=Payment {{ $('One Item per Proposed Match').item.json.line.LineID }}",
          "responseFormButtonLabel": "Submit decision",
          "limitWaitTime": {
            "values": {
              "limitType": "afterTimeInterval",
              "resumeAmount": 24,
              "resumeUnit": "hours"
            }
          }
        }
      },
