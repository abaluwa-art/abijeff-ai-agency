      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        2540,
        300
      ],
      "notes": "Marks the line immediately so it is never proposed again (idempotency).",
      "notesInFlow": true,
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// One item per order covered by each payment just created (uses n8n item pairing, so denied matches never shift the data).\nconst out = [];\n$input.all().forEach((item, i) => {\n  const m = $('One Item per Proposed Match').itemMatching(i).json;\n  const paymentId = String($('QBO – Create Payment').itemMatching(i).json.Payment.Id);\n  const approvedBy = $('Telegram – Approve Payment Match').itemMatching(i).json.data?.Reviewer || '';\n  for (const a of m.allocations.filter(x => x.applied > 0)) {\n    out.push({ pairedItem: { item: i }, json: { recordId: a.recordId, OrderID: a.OrderID, fullyPaid: a.fullyPaid,\n      applied: a.applied, paymentId, lineId: m.line.LineID, approvedBy } });\n  }\n});\nreturn out;"
      },
