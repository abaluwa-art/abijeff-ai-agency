      "id": "0fb09cb7-60b6-4f57-ac92-90e0a607f8e2",
      "name": "Audit – Matches Proposed",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        1660,
        140
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// One item per proposed match, with the QuickBooks payment body built by code.\nconst pack = $('Build Match Pack').first().json;\nconst out = [];\nfor (const m of ($input.first().json.output.matches || [])) {\n  if (!(Number(m.confidence) >= 0.5)) continue;\n  const line = pack.lines.find(l => l.LineID === String(m.bank_line_id));\n  const invs = (m.invoice_ids || []).map(id => pack.openInvoices.find(o => o.InvoiceID === String(id) || o.OrderID === String(id) || o.ZRA_InvoiceNo === String(id))).filter(Boolean);\n  if (!line || !invs.length) continue;\n  const customers = [...new Set(invs.map(i => i.QBO_CustomerID))];\n  const currencies = [...new Set(invs.map(i => i.Currency))];\n  const issues = [];\n  if (customers.length !== 1 || !customers[0]) issues.push('Invoices belong to different or unknown QuickBooks customers');\n  if (currencies.length !== 1 || currencies[0] !== line.Currency) issues.push(`Currency mismatch: bank ${line.Currency}, invoice ${currencies.join('/')}`);\n  let left = line.Amount;\n  const alloc = invs.map(i => { const a = Math.round(Math.min(left, i.Amount) * 100) / 100; left = Math.round((left - a) * 100) / 100; return { ...i, applied: a, fullyPaid: a >= i.Amount - 0.01 }; });\n  if (left > 0.01) issues.push(`Overpayment of ${line.Currency} ${left} not applied (needs your decision)`);\n  out.push({ pairedItem: { item: 0 }, json: {\n    line, confidence: m.confidence, reason: m.reason, allocations: alloc, issues, ok: issues.length === 0,\n    qboBody: { CustomerRef: { value: customers[0] || '' }, TotalAmt: Math.round((line.Amount - Math.max(left, 0)) * 100) / 100,\n      TxnDate: String(line.Date || '').slice(0, 10) || $now.toFormat('yyyy-MM-dd'), PaymentRefNum: line.LineID.slice(0, 21),\n      CurrencyRef: { value: line.Currency }, PrivateNote: `AIOS bank line ${line.LineID}: ${line.Payer} / ${line.Reference}`.slice(0, 4000),\n      Line: alloc.filter(a => a.applied > 0).map(a => ({ Amount: a.applied, LinkedTxn: [{ TxnId: a.InvoiceID, TxnType: 'Invoice' }] })) },\n  } });\n}\nreturn out;"
      },
      "id": "d98f5809-5f9b-45bf-b044-718948fb5ef1",
      "name": "One Item per Proposed Match",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1660,
        400
      ],
      "notes": "Matches below 0.5 confidence are not proposed. Allocation and QuickBooks body are built here, not by the AI.",
      "notesInFlow": true
    },
    {
