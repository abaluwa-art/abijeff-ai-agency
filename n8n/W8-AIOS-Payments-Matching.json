      "typeVersion": 4.5,
      "position": [
        400,
        300
      ],
      "notes": "Tab BankLines: LineID, Date, Amount, Currency, Payer, Reference, Status, MatchedInvoices. Paste the day's bank / mobile-money statement; leave Status empty.",
      "notesInFlow": true,
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Bank / mobile-money lines not yet applied. Paste each day's statement into the BankLines tab.\nconst lines = $input.all().map(i => i.json)\n  .filter(r => r.LineID && !String(r.Status || '').trim() && Number(r.Amount) > 0)\n  .map(r => ({ LineID: String(r.LineID), Date: r.Date, Amount: Number(r.Amount), Currency: String(r.Currency || 'ZMW').toUpperCase(),\n               Payer: r.Payer, Reference: String(r.Reference || '') }));\nif (!lines.length) return [];\nreturn [{ pairedItem: { item: 0 }, json: { lines } }];"
      },
      "id": "631d2227-2147-4b95-813c-dd9fef2defa6",
      "name": "Pending Bank Lines",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        600,
        300
      ]
    },
    {
      "parameters": {
        "operation": "search",
        "base": {
          "__rl": true,
          "value": "",
          "mode": "list",
          "cachedResultName": "AIOS_OPS"
        },
        "table": {
          "__rl": true,
          "value": "",
          "mode": "list",
          "cachedResultName": "Orders"
        },
        "filterByFormula": "=AND({Status}='Invoiced', {PaymentID}='')",
        "options": {},
        "returnAll": true
      },
      "id": "e0188eb4-75d0-43f1-88ee-43170d05daaf",
      "name": "Load Open Invoices",
      "type": "n8n-nodes-base.airtable",
      "typeVersion": 2.1,
